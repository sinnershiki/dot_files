layout {
    pane split_direction="vertical" {
        // 左側(60%の幅)でリポジトリをpeco選択してからclaudeを起動
        pane size="60%" {
            command "zsh"
            args "-c" "cd \"$(ghq root)/$(ghq list | peco)\" && exec claude --resume"
        }
        // 右側(40%の幅)は通常のターミナル
        pane
    }
    // 以下はZellij標準のタブ・ステータスバー
    pane size=1 borderless=true {
        plugin location="zellij:tab-bar"
    }
    pane size=2 borderless=true {
        plugin location="zellij:status-bar"
    }
}
